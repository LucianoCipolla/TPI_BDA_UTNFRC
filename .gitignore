# ===== Maven =====
# Carpeta donde Maven deja lo compilado (.class) y el .jar empaquetado.
target/

# ===== IDEs =====
.idea/
*.iml
.vscode/

# ===== Bases H2 embebidas =====
# Cada microservicio crea su base en ./data al arrancar (jdbc:h2:file:./data/...).
data/
*.mv.db
*.trace.db

# ===== Logs y sistema operativo =====
*.log
Thumbs.db
.DS_Store
# ===== Documentos del equipo =====
# De Docs/ solo se suben la Entrega 1 y los diagramas.
# El resto (defensa, guía de pruebas, plan, colecciones de Postman, etc.) queda solo en la compu de cada uno.
Docs/*
!Docs/TPI-CampusReservas-Entrega-1-1.docx
!Docs/diagramas/

# Colecciones y environments de Postman, estén donde estén
*.postman_collection.json
*.postman_environment.json
GUIA-BACKEND.md

# Archivos temporales que crea Word mientras un documento está abierto
~$*
